T_0.0 ; Top of for-loop
    %load/vec4 v0x19a10e0_0;
    %cmpi/s 8, 0, 32;
    %jmp/0xz T_0.1, 5;
    %vpi_call 2 133 "$write", "%d\011", &A<v0x199f0e0, v0x19a10e0_0 > {0 0 0};
T_0.2 ; for-loop step statement
    %load/vec4 v0x19a10e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x19a10e0_0, 0, 32;
    %jmp T_0.0;
T_0.1 ; for-loop exit label
